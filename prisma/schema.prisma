generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id
  email        String @unique
  displayName  String
  role         String
  passwordHash String
}


model Event {
  id            String   @id @default(cuid())
  title         String
  description   String
  location      String
  category      String
  capacity      Int?
  status        String   @default("draft")
  startDateTime DateTime
  endDateTime   DateTime
  organizerId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rsvps         RSVP[]
}

model RSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("going")
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
}

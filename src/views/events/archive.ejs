<section class="mb-4 sm:mb-5 p-4 sm:p-6 border border-slate-200 rounded-xl sm:rounded-2xl bg-gradient-to-b from-white to-slate-100 shadow-lg">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div>
      <p class="text-xs sm:text-sm uppercase tracking-[0.2em] text-slate-500 font-semibold mb-2">Archive</p>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-700 mb-2 sm:mb-3">Past Events</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Browse events that have already taken place, most recently ended first.
      </p>
    </div>
    <a
      href="/events"
      class="w-full sm:w-auto text-center px-3.5 py-2 rounded-lg bg-white text-slate-600 border border-slate-200 text-sm font-medium no-underline hover:bg-slate-50"
    >
      Back to Events
    </a>
  </div>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<% if (categories.length > 0) { %>
  <section
    class="p-4 sm:p-5 border border-slate-200 rounded-xl sm:rounded-2xl bg-white shadow-lg mb-5"
    x-data="{ activeCategory: '<%= category.replace(/'/g, "\\'") %>' }"
  >
    <form
      action="/events/archive"
      method="GET"
      hx-get="/events/archive"
      hx-target="#archive-results"
      hx-swap="innerHTML"
      hx-push-url="true"
      hx-trigger="change from:.category-radio"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-medium text-slate-500 mr-1">Filter by category:</span>

        <label class="cursor-pointer">
          <input
            class="category-radio sr-only"
            type="radio"
            name="category"
            value=""
            <%= category === '' ? 'checked' : '' %>
            @change="activeCategory = ''"
          />
          <span
            class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium border transition-colors"
            :class="activeCategory === '' ? 'bg-slate-600 border-slate-600 text-white' : 'bg-white border-slate-300 text-slate-500 hover:border-slate-400 hover:text-slate-700'"
          >
            All
          </span>
        </label>

        <% for (const cat of categories) { %>
          <label class="cursor-pointer">
            <input
              class="category-radio sr-only"
              type="radio"
              name="category"
              value="<%= cat %>"
              <%= category === cat ? 'checked' : '' %>
              @change="activeCategory = '<%= cat.replace(/'/g, "\\'") %>'"
            />
            <span
              class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium border transition-colors"
              :class="activeCategory === '<%= cat.replace(/'/g, "\\'") %>' ? 'bg-slate-600 border-slate-600 text-white' : 'bg-white border-slate-300 text-slate-500 hover:border-slate-400 hover:text-slate-700'"
            >
              <%= cat %>
            </span>
          </label>
        <% } %>

        <!-- Clear filter — only shown when a category is active -->
        <button
          type="button"
          x-show="activeCategory !== ''"
          style="display: none;"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          @click="activeCategory = ''; $nextTick(() => { document.querySelector('.category-radio[value=\\'\\']').click(); })"
          class="px-3 py-1.5 rounded-full text-sm font-medium text-slate-400 hover:text-slate-600 border border-transparent hover:border-slate-200 transition-colors cursor-pointer"
        >
          Clear
        </button>

        <noscript>
          <button
            type="submit"
            class="px-3.5 py-1.5 rounded-lg bg-slate-600 text-white text-sm font-medium cursor-pointer hover:bg-slate-700"
          >
            Apply
          </button>
        </noscript>
      </div>
    </form>
  </section>
<% } %>

<div id="archive-results">
  <%- include("partials/archive-results", { events, category, categories, pageError: null }) %>
</div>

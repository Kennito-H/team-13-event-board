<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Events</h1>
      <p class="text-slate-500">
        Browse published events. Filter by category or timeframe.
      </p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/events/archive" class="px-3.5 py-2 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium no-underline hover:bg-slate-50">
        Archive
      </a>
      <a href="/events/new" class="px-3.5 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium no-underline hover:bg-blue-700">
        + Create Event
      </a>
    </div>
  </div>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section
  class="p-5 border border-slate-200 rounded-2xl bg-white shadow-lg mb-5"
  x-data="{ category: '<%= selectedCategory %>', timeframe: '<%= selectedTimeframe %>', query: '<%= selectedQuery %>' }"
>
  <form
    action="/events"
    method="GET"
    hx-get="/events"
    hx-target="#event-list-results"
    hx-swap="innerHTML"
    hx-push-url="true"
    hx-trigger="change, keyup changed delay:300ms from:input[name='category'], keyup changed delay:300ms from:input[name='q']"
    class="flex flex-col gap-4"
  >
    <!-- Search input -->
    <div class="relative">
      <input
        id="search-input"
        type="text"
        name="q"
        x-model="query"
        value="<%= selectedQuery %>"
        placeholder="Search events by title, description, or location…"
        autocomplete="off"
        class="w-full pl-4 pr-10 py-2.5 border rounded-xl bg-white text-slate-900 placeholder:text-slate-400 focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 transition-colors"
        :class="query ? 'border-blue-400' : 'border-slate-300'"
      />
      <!-- Alpine clear button -->
      <button
        type="button"
        x-show="query.length > 0"
        style="display: none;"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 scale-75"
        x-transition:enter-end="opacity-100 scale-100"
        @click="query = ''; $nextTick(() => htmx.trigger($el.closest('form'), 'submit'))"
        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 cursor-pointer transition-colors"
        aria-label="Clear search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Category + Timeframe row -->
    <div class="flex flex-wrap items-end gap-4">
      <label class="flex flex-col text-sm text-slate-600 grow min-w-[200px]">
        <span class="mb-1 font-medium">Category</span>
        <input
          type="text"
          name="category"
          x-model="category"
          value="<%= selectedCategory %>"
          placeholder="Any category"
          class="px-3 py-2 border rounded-lg bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
          :class="category ? 'border-blue-500 ring-1 ring-blue-500/20' : 'border-slate-300'"
        />
      </label>

      <div class="flex flex-col text-sm text-slate-600">
        <span class="mb-1 font-medium">Timeframe</span>
        <div class="flex flex-wrap gap-1.5">
          <% const timeframeOptions = [
            { value: '', label: 'All' },
            { value: 'upcoming', label: 'Upcoming' },
            { value: 'this-week', label: 'This week' },
            { value: 'this-weekend', label: 'This weekend' },
          ]; %>
          <% for (const tf of timeframeOptions) { %>
            <label class="cursor-pointer">
              <input
                type="radio"
                name="timeframe"
                value="<%= tf.value %>"
                x-model="timeframe"
                class="sr-only peer"
                <%= selectedTimeframe === tf.value ? 'checked' : '' %>
              />
              <span
                class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium border transition-colors peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-blue-500/40"
                :class="timeframe === '<%= tf.value %>' ? 'bg-blue-600 border-blue-600 text-white shadow-sm' : 'bg-white border-slate-300 text-slate-600 hover:border-blue-400 hover:text-blue-600'"
              >
                <%= tf.label %>
              </span>
            </label>
          <% } %>
        </div>
      </div>

      <div class="flex items-center gap-2 ml-auto">
        <button
          type="button"
          x-show="category || timeframe || query"
          style="display: none;"
          @click="category = ''; timeframe = ''; query = ''"
          hx-get="/events"
          hx-target="#event-list-results"
          hx-swap="innerHTML"
          hx-push-url="true"
          class="px-3.5 py-2 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium cursor-pointer hover:bg-slate-50"
        >
          Clear filters
        </button>
        <noscript>
          <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700">
            Apply
          </button>
        </noscript>
      </div>
    </div>
  </form>
</section>

<div id="event-list-results">
  <%- include("partials/list-results", { events, pageError }) %>
</div>

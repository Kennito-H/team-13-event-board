<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Events</h1>
  <p class="text-slate-500">
    Browse published events. Filter by category or timeframe.
  </p>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="p-5 border border-slate-200 rounded-2xl bg-white shadow-lg mb-5">
  <form action="/events" method="GET" class="flex flex-wrap items-end gap-3">
    <label class="flex flex-col text-sm text-slate-600">
      <span class="mb-1 font-medium">Category</span>
      <input
        type="text"
        name="category"
        value="<%= selectedCategory %>"
        placeholder="Any category"
        class="px-3 py-2 border border-slate-300 rounded-lg bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </label>

    <label class="flex flex-col text-sm text-slate-600">
      <span class="mb-1 font-medium">Timeframe</span>
      <select
        name="timeframe"
        class="px-3 py-2 border border-slate-300 rounded-lg bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      >
        <option value="" <%= selectedTimeframe === '' ? 'selected' : '' %>>All</option>
        <option value="upcoming" <%= selectedTimeframe === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
        <option value="this-week" <%= selectedTimeframe === 'this-week' ? 'selected' : '' %>>This week</option>
        <option value="this-weekend" <%= selectedTimeframe === 'this-weekend' ? 'selected' : '' %>>This weekend</option>
      </select>
    </label>

    <button
      type="submit"
      class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700"
    >
      Apply
    </button>
  </form>
</section>

<% if (events.length === 0) { %>
  <section class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg text-center">
    <p class="text-slate-500">No events match the current filters.</p>
  </section>
<% } else { %>
  <p class="text-sm text-slate-500 mb-3">
    <%= events.length %> event<%= events.length === 1 ? '' : 's' %>
  </p>

  <ul class="list-none m-0 p-0 grid gap-3.5">
    <% for (const event of events) { %>
      <li class="p-5 border border-slate-200 rounded-2xl bg-white shadow-lg">
        <div class="flex items-center justify-between gap-3 mb-2">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-600/10 text-blue-700">
            <%= event.category %>
          </span>
          <span class="text-sm text-slate-400">
            <%= event.startDateTime.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
            &middot;
            <%= event.startDateTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
          </span>
        </div>
        <h2 class="text-lg font-semibold text-slate-900 mb-1">
          <a href="/events/<%= event.id %>" class="text-slate-900 no-underline hover:text-blue-700 hover:underline">
            <%= event.title %>
          </a>
        </h2>
        <p class="text-sm text-slate-500 mb-2">📍 <%= event.location %></p>
        <p class="text-sm text-slate-600 leading-relaxed mb-0">
          <%= event.description.length > 160 ? event.description.slice(0, 157) + '…' : event.description %>
        </p>
        <% if (event.capacity) { %>
          <p class="text-xs text-slate-400 mt-2 mb-0">Capacity: <%= event.capacity %></p>
        <% } %>
      </li>
    <% } %>
  </ul>
<% } %>

<section class="mb-4 sm:mb-5 p-4 sm:p-6 border border-slate-200 rounded-xl sm:rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div>
      <p class="text-xs sm:text-sm uppercase tracking-[0.2em] text-blue-700 font-semibold mb-2">Search</p>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 mb-2 sm:mb-3">Event Search</h1>
      <p class="text-sm sm:text-base text-slate-500">
        Find published upcoming events by title, description, or location.
      </p>
    </div>
    <a
      href="/events"
      class="w-full sm:w-auto text-center px-3.5 py-2 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium no-underline hover:bg-slate-50"
    >
      Back to Events
    </a>
  </div>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="p-4 sm:p-6 border border-slate-200 rounded-xl sm:rounded-2xl bg-white shadow-lg mb-5">
  <form
    action="/events/search"
    method="GET"
    hx-get="/events/search"
    hx-target="#search-results"
    hx-swap="innerHTML"
    hx-trigger="input delay:300ms from:#search-input, submit"
    hx-push-url="true"
    x-data="{ query: '<%= query.replace(/'/g, "\\'") %>' }"
  >
    <div class="relative flex gap-2.5">
      <div class="relative flex-1">
        <input
          id="search-input"
          type="text"
          name="q"
          x-model="query"
          value="<%= query %>"
          placeholder="Search events by title, description, or location…"
          autocomplete="off"
          class="w-full pl-4 pr-10 py-2.5 border border-slate-300 rounded-xl bg-white text-slate-900 placeholder:text-slate-400 focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 transition-colors"
          :class="query ? 'border-blue-400' : 'border-slate-300'"
        />
        <!-- Clear button — only visible when field has content -->
        <button
          type="button"
          x-show="query.length > 0"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 scale-75"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-75"
          @click="query = ''; $nextTick(() => { document.getElementById('search-input').focus(); htmx.trigger(document.getElementById('search-input').closest('form'), 'submit'); })"
          style="display: none;"
          class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 cursor-pointer transition-colors"
          aria-label="Clear search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <button
        type="submit"
        class="px-4 sm:px-5 py-2.5 rounded-xl bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 transition-colors whitespace-nowrap"
      >
        Search
      </button>
    </div>
  </form>
</section>

<div id="search-results">
  <%- include("partials/search-results", { events, query, pageError: null }) %>
</div>

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-600/10 text-blue-700">
          <%= event.category %>
        </span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
          <%= event.status === 'published' ? 'bg-green-100 text-green-700' :
              event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
              event.status === 'past' ? 'bg-slate-100 text-slate-500' :
              'bg-yellow-100 text-yellow-700' %>">
          <%= event.status %>
        </span>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-2"><%= event.title %></h1>
      <p class="text-slate-500">📍 <%= event.location %></p>
    </div>
    <a
      href="/events"
      class="px-3.5 py-2 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium no-underline hover:bg-slate-50"
    >
      Back to Events
    </a>
  </div>
</section>

<div class="grid gap-5 md:grid-cols-3">
  <section class="md:col-span-2 p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <h2 class="text-lg font-semibold text-slate-900 mb-3">About</h2>
    <p class="text-slate-600 leading-relaxed mb-5"><%= event.description %></p>

    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <p class="font-medium text-slate-700 mb-0.5">Start</p>
        <p class="text-slate-500"><%= new Date(event.startDateTime).toLocaleString() %></p>
      </div>
      <div>
        <p class="font-medium text-slate-700 mb-0.5">End</p>
        <p class="text-slate-500"><%= new Date(event.endDateTime).toLocaleString() %></p>
      </div>
      <% if (event.capacity) { %>
      <div>
        <p class="font-medium text-slate-700 mb-0.5">Capacity</p>
        <p class="text-slate-500"><%= event.capacity %></p>
      </div>
      <% } %>
    </div>
  </section>

  <section class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <h2 class="text-lg font-semibold text-slate-900 mb-4">Actions</h2>
    <div class="flex flex-col gap-2">

      <a
        href="/events/<%= event.id %>/edit"
        class="px-4 py-2.5 rounded-lg bg-white text-slate-700 border border-slate-300 text-sm font-medium no-underline text-center hover:bg-slate-50"
      >
        Edit
      </a>

      <% if (event.status === "draft") { %>
        <form method="POST" action="/events/<%= event.id %>/publish">
          <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-green-600 text-white text-sm font-medium cursor-pointer hover:bg-green-700"
          >
            Publish Event
          </button>
        </form>
      <% } %>

      <% if (event.status === "published") { %>
        <form method="POST" action="/events/<%= event.id %>/rsvp">
          <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium cursor-pointer hover:bg-blue-700"
          >
            RSVP
          </button>
        </form>
        <form method="POST" action="/events/<%= event.id %>/cancel">
          <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-red-50 text-red-700 border border-red-200 text-sm font-medium cursor-pointer hover:bg-red-100"
          >
            Cancel Event
          </button>
        </form>
      <% } %>

    </div>
  </section>
</div>

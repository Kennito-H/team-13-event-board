<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } else if (events.length === 0) { %>
  <section class="p-6 border border-slate-200 rounded-2xl bg-slate-50 shadow-lg text-center">
    <% if (category && category.trim().length > 0) { %>
      <p class="text-slate-400 mb-1">No archived events in the <strong class="text-slate-500"><%= category %></strong> category.</p>
      <p class="text-sm text-slate-400">Try selecting a different category or view all.</p>
    <% } else { %>
      <p class="text-slate-400">No past events yet.</p>
    <% } %>
  </section>
<% } else { %>
  <p class="text-sm text-slate-400 mb-3">
    <%= events.length %> past event<%= events.length === 1 ? '' : 's' %>
    <% if (category && category.trim().length > 0) { %>
      in <strong class="text-slate-500"><%= category %></strong>
    <% } %>
  </p>
  <ul class="list-none m-0 p-0 grid gap-3">
    <% for (const event of events) { %>
      <li class="p-5 border border-slate-200 rounded-2xl bg-slate-50 shadow-sm opacity-80 hover:opacity-100 transition-opacity">
        <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-200 text-slate-500">
            <%= event.category %>
          </span>
          <span class="text-xs text-slate-400 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            Ended <%= event.endDateTime.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
          </span>
        </div>
        <h2 class="text-base sm:text-lg font-semibold text-slate-500 mb-1"><%= event.title %></h2>
        <p class="text-sm text-slate-400 mb-2">📍 <%= event.location %></p>
        <p class="text-sm text-slate-400 leading-relaxed mb-0">
          <%= event.description.length > 160 ? event.description.slice(0, 157) + '…' : event.description %>
        </p>
      </li>
    <% } %>
  </ul>
<% } %>

<%
  const statusStyles = {
    draft: "bg-slate-100 text-slate-700 border-slate-200",
    published: "bg-emerald-100 text-emerald-800 border-emerald-200",
    cancelled: "bg-rose-100 text-rose-800 border-rose-200",
    past: "bg-amber-100 text-amber-800 border-amber-200",
  };

  const statusClass = statusStyles[event.status] ?? "bg-slate-100 text-slate-700 border-slate-200";
%>

<aside class="border border-slate-200 rounded-2xl bg-white shadow-lg p-6">
  <div class="flex items-center justify-between gap-3 flex-wrap mb-5">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-slate-500 font-semibold mb-2">Status</p>
      <span class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-semibold <%= statusClass %>">
        <%= event.status %>
      </span>
    </div>

    <% if (isOrganizer || isAdmin) { %>
      <a
        href="/events/<%= event.id %>/edit"
        class="px-4 py-2.5 rounded-lg bg-white text-slate-700 border border-slate-300 text-sm font-medium no-underline hover:bg-slate-50"
      >
        Edit Event
      </a>
    <% } %>
  </div>

  <% if (transitionError) { %>
    <%- include("../../partials/error", { message: transitionError }) %>
  <% } %>

  <div class="grid gap-3">
    <% if ((isOrganizer || isAdmin) && event.status === "draft") { %>
      <form
        method="POST"
        action="/events/<%= event.id %>/publish"
        hx-post="/events/<%= event.id %>/publish"
        hx-target="#event-detail-actions"
        hx-swap="innerHTML"
        class="m-0"
        >
        <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-emerald-600 text-white font-medium cursor-pointer hover:bg-emerald-700 border-0"
        >
            Publish Event
        </button>
        </form>

    <% } %>

    <% if ((isOrganizer || isAdmin) && event.status === "published") { %>
      <form
        method="POST"
        action="/events/<%= event.id %>/cancel"
        hx-post="/events/<%= event.id %>/cancel"
        hx-target="#event-detail-actions"
        hx-swap="innerHTML"
        class="m-0"
        >
        <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-rose-600 text-white font-medium cursor-pointer hover:bg-rose-700 border-0"
        >
            Cancel Event
        </button>
        </form>

    <% } %>

    <% if (event.status === "published") { %>
      <div id="rsvp-action">
            <%- include("../../rsvp/partials/rsvp-button", { eventId: event.id }) %>
      </div>
    <% } %>
  </div>

  <% if (rsvpError) { %>
    <section class="mt-4">
      <%- include("../../partials/error", { message: rsvpError }) %>
    </section>
  <% } %>
</aside>

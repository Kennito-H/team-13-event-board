<section id="create-form-container" class="border border-slate-200 rounded-2xl bg-white shadow-lg overflow-hidden">
  <% if (pageError) { %>
    <%- include("../partials/error", { message: pageError }) %>
  <% } %>

  <form
    method="POST"
    action="/events"
    hx-post="/events"
    hx-target="#create-form-container"
    hx-swap="outerHTML"
    class="p-6 md:p-8"
  >
    <div class="grid gap-5 md:grid-cols-2">
      <label class="flex flex-col gap-1.5 md:col-span-2">
        <span class="text-sm font-medium text-slate-700">Title</span>
        <input id="title" name="title" type="text"
          value="<%= (typeof form !== 'undefined' && form.title) ? form.title : '' %>"
          required placeholder="Spring networking mixer"
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500" />
      </label>

      <label class="flex flex-col gap-1.5 md:col-span-2">
        <span class="text-sm font-medium text-slate-700">Description</span>
        <textarea id="description" name="description" required rows="5"
          placeholder="What is happening, who it is for, and what people should expect."
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500"
        ><%= (typeof form !== 'undefined' && form.description) ? form.description : '' %></textarea>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-slate-700">Location</span>
        <input id="location" name="location" type="text"
          value="<%= (typeof form !== 'undefined' && form.location) ? form.location : '' %>"
          required placeholder="Campus Center Ballroom"
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500" />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-slate-700">Category</span>
        <input id="category" name="category" type="text"
          value="<%= (typeof form !== 'undefined' && form.category) ? form.category : '' %>"
          required placeholder="Social"
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500" />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-slate-700">Start</span>
        <input id="startDateTime" name="startDateTime" type="datetime-local"
          value="<%= (typeof form !== 'undefined' && form.startDateTime) ? form.startDateTime : '' %>"
          required
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500" />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-slate-700">End</span>
        <input id="endDateTime" name="endDateTime" type="datetime-local"
          value="<%= (typeof form !== 'undefined' && form.endDateTime) ? form.endDateTime : '' %>"
          required
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500" />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-slate-700">Capacity</span>
        <input id="capacity" name="capacity" type="number" min="1"
          value="<%= (typeof form !== 'undefined' && form.capacity) ? form.capacity : '' %>"
          placeholder="Optional"
          class="px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-sky-500/20 focus:border-sky-500" />
      </label>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3">
      <a href="/events"
        class="px-4 py-2.5 rounded-lg bg-white text-slate-700 border border-slate-300 text-sm font-medium no-underline hover:bg-slate-50">
        Cancel
      </a>
      <button type="submit"
        class="px-5 py-2.5 rounded-lg bg-sky-600 text-white font-medium cursor-pointer hover:bg-sky-700">
        Save Draft
      </button>
    </div>
  </form>
</section>
<form id="rsvp-action"
      method="POST"
      action="/events/<%= eventId %>/rsvp"
      hx-post="/events/<%= eventId %>/rsvp"
      hx-target="#rsvp-action"
      hx-swap="outerHTML"
      class="m-0">
  <% if (!rsvp || rsvp.status === 'cancelled') { %>
    <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium cursor-pointer hover:bg-blue-700">
      RSVP to Event
    </button>
  <% } else if (rsvp.status === 'waitlisted') { %>
    <% const position = typeof waitlistPosition !== 'undefined' ? waitlistPosition : null; %>
    <% if (position !== null) { %>
      <p class="mb-2 text-sm text-yellow-800 bg-yellow-50 border border-yellow-200 rounded-lg px-3 py-2">
        You're <strong>#<%= position %></strong> on the waitlist
      </p>
    <% } %>
    <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-yellow-50 text-yellow-700 border border-yellow-200 text-sm font-medium cursor-pointer hover:bg-yellow-100">
      Leave Waitlist
    </button>
  <% } else { %>
    <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-slate-100 text-slate-600 text-sm font-medium cursor-pointer hover:bg-slate-200">
      Cancel RSVP
    </button>
  <% } %>
</form>

<form id="rsvp-action"
      method="POST"
      action="/events/<%= eventId %>/rsvp"
      hx-post="/events/<%= eventId %>/rsvp"
      hx-target="#rsvp-action"
      hx-swap="outerHTML"
      class="m-0">
  <div x-data="{ visible: false }"
       x-init="$nextTick(() => visible = true)"
       x-show="visible"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 scale-95"
       x-transition:enter-end="opacity-100 scale-100">
    <% if (!rsvp || rsvp.status === 'cancelled') { %>
      <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium cursor-pointer hover:bg-blue-700 transition-colors">
        RSVP to Event
      </button>
    <% } else if (rsvp.status === 'waitlisted') { %>
      <% const position = typeof waitlistPosition !== 'undefined' ? waitlistPosition : null; %>
      <% if (position !== null) { %>
        <p class="mb-2 text-sm text-yellow-800 bg-yellow-50 border border-yellow-200 rounded-lg px-3 py-2">
          You're <strong>#<%= position %></strong> on the waitlist
        </p>
      <% } %>
      <div x-data="{ confirming: false }">
        <button x-show="!confirming"
                @click.prevent="confirming = true"
                class="w-full px-4 py-2.5 rounded-lg bg-red-50 text-red-700 border border-red-200 text-sm font-medium cursor-pointer hover:bg-red-100 transition-colors">
          Leave Waitlist
        </button>
        <div x-show="confirming" class="flex items-center gap-2">
          <button type="button"
                  @click="confirming = false"
                  class="px-4 py-2.5 rounded-lg bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium cursor-pointer hover:bg-slate-100 transition-colors">
            Cancel
          </button>
          <button type="submit"
                  class="px-4 py-2.5 rounded-lg bg-red-50 text-red-700 border border-red-200 text-sm font-medium cursor-pointer hover:bg-red-100 transition-colors">
            OK
          </button>
        </div>
      </div>
    <% } else { %>
      <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-green-50 text-green-700 border border-green-200 text-sm font-medium cursor-pointer hover:bg-green-100 transition-colors">
        ✓ Attending — Cancel RSVP
      </button>
    <% } %>
  </div>
</form>

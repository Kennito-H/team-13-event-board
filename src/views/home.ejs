      <div class="text-4xl font-black font-mono leading-none" x-text="score"></div>
      <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">Points</div>
    </div>
    <div class="text-center flex-1 px-3">
      <div x-show="streak >= 3" class="text-orange-400 font-bold text-sm" x-text="'🔥 ' + streak + ' in a row!'"></div>
      <div x-show="streak < 3 && attempts > 0" class="text-slate-400 text-sm font-mono" x-text="Math.round(made / attempts * 100) + '% FG'"></div>
      <div x-show="attempts === 0" class="text-slate-600 text-sm">Ready?</div>
    </div>
    <div class="text-center min-w-[4.5rem]">
      <div class="text-xl font-bold font-mono leading-none">
        <span x-text="made"></span><span class="text-slate-500 font-normal">/</span><span x-text="attempts"></span>
      </div>
      <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">Makes</div>
    </div>
  </div>


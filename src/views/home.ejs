<script>
  function basketballGame() {
    return {
      ballX: 55, ballY: 300, ballRotation: 0,
      shooting: false, scored: false, missed: false, netJiggling: false,
      score: 0, attempts: 0, made: 0, streak: 0,

      chargingPower: false, powerLevel: 0, powerDirection: 1, powerTimer: null,

      targetPower: 80,

      gravity: 2000,

      get trajectoryPath() {
        const phys = this.shotPhysics(this.powerLevel);
        const totalT = this.flightTime(phys);
        const halfT = totalT / 2;
        const steps = 18;
        let path = `M ${phys.sx.toFixed(1)} ${phys.sy.toFixed(1)}`;
        for (let i = 1; i <= steps; i++) {
          const t = (halfT / steps) * i;
          const x = phys.sx + phys.vx * t;
          const y = phys.sy + phys.vy * t + 0.5 * this.gravity * t * t;
          path += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        return path;
      },

      shotPhysics(power) {
        const sx = 55, sy = 300;
        const t = power / this.targetPower;
        const vx = 478 * t;
        const vy = -1014 * t;
        return { sx, sy, vx, vy };
      },

      flightTime(phys) {
        const a = 0.5 * this.gravity;
        const b = phys.vy;
        const c = phys.sy - 325;
        const disc = b * b - 4 * a * c;
        return disc < 0 ? 1 : (-b + Math.sqrt(disc)) / (2 * a);
      },

      randomizeTarget() {
        this.targetPower = Math.floor(30 + Math.random() * 50);
      },

      startPowerCharge() {
        if (this.shooting || this.chargingPower) return;
        this.randomizeTarget();
        this.chargingPower = true;
        this.powerLevel = 0;
        this.powerDirection = 1;
        this.powerTimer = setInterval(() => {
          this.powerLevel += this.powerDirection * 2.3;
          if (this.powerLevel >= 100) { this.powerLevel = 100; this.powerDirection = -1; }
          if (this.powerLevel <= 0)   { this.powerLevel = 0;   this.powerDirection = 1; }
        }, 20);
      },

      releaseAndShoot() {
        if (!this.chargingPower) return;
        clearInterval(this.powerTimer);
        this.chargingPower = false;
        this.shoot();
        setTimeout(() => { this.powerLevel = 0; }, 400);
      },

      shoot() {
        if (this.shooting) return;
        this.shooting = true;
        this.scored = false;
        this.missed = false;
        this.attempts++;

        const phys = this.shotPhysics(this.powerLevel);
        let posX = phys.sx, posY = phys.sy;
        const jitter = 0.05;
        let vx = phys.vx * (1 + (Math.random() - 0.5) * 2 * jitter);
        let vy = phys.vy * (1 + (Math.random() - 0.5) * 2 * jitter);
        let elapsed = 0;
        const ballR = 24;
        const rimY = 164, rimL = 445, rimR = 478;
        let lastT = performance.now();

        const animate = (now) => {
          const dt = Math.min((now - lastT) / 1000, 0.033);
          lastT = now;
          elapsed += dt;
          const prevY = posY;
          vy += this.gravity * dt;
          posX += vx * dt;
          posY += vy * dt;

          if (vy > 0 && prevY < rimY && posY >= rimY && posX > rimL && posX < rimR) {
            this.ballX = posX; this.ballY = posY;
            this.onMake();
            return;
          }

          const bbL = 500, bbR = 515, bbT = 48, bbB = 180;
          if (posX + ballR > bbL && posX - ballR < bbR &&
              posY + ballR > bbT && posY - ballR < bbB) {
            const oL = (posX + ballR) - bbL;
            const oR = bbR - (posX - ballR);
            const oT = (posY + ballR) - bbT;
            const oB = bbB - (posY - ballR);
            const m = Math.min(oL, oR, oT, oB);
            if (m === oL && vx > 0)      { posX = bbL - ballR; vx = -Math.abs(vx) * 0.5; }
            else if (m === oR && vx < 0) { posX = bbR + ballR; vx =  Math.abs(vx) * 0.5; }
            else if (m === oT && vy > 0) { posY = bbT - ballR; vy = -Math.abs(vy) * 0.4; vx *= 0.7; }
            else if (m === oB && vy < 0) { posY = bbB + ballR; vy =  Math.abs(vy) * 0.4; }
          }

          if (!(posX > rimL && posX < rimR)) {
            for (const post of [{ x: 425, y: 160 }, { x: 497, y: 160 }]) {
              const dx = posX - post.x, dy = posY - post.y;
              const d = Math.hypot(dx, dy);
              if (d < ballR + 4 && d > 0) {
                const nx = dx / d, ny = dy / d;
                posX = post.x + nx * (ballR + 4);
                posY = post.y + ny * (ballR + 4);
                const vDotN = vx * nx + vy * ny;
                if (vDotN < 0) { vx -= 1.4 * vDotN * nx; vy -= 1.4 * vDotN * ny; }
              }
            }
          }

          this.ballX = posX;
          this.ballY = posY;
          this.ballRotation = elapsed * 720;

          if (posY >= 325 - ballR || posX > 580 || posX < -50) {
            this.ballY = Math.min(posY, 325 - ballR);
            this.onMiss();
            return;
          }
          requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
      },

      onMake() {
        this.score += 2;
        this.made++;
        this.streak++;
        this.scored = true;
        this.netJiggling = true;
        setTimeout(() => { this.netJiggling = false; }, 560);
        setTimeout(() => { this.scored = false; this.resetBall(); }, 1100);
      },

      onMiss() {
        this.streak = 0;
        this.missed = true;
        setTimeout(() => { this.missed = false; this.resetBall(); }, 800);
      },

      resetBall() {
        this.ballX = 55; this.ballY = 300; this.ballRotation = 0; this.shooting = false;
      },

      reset() {
        if (this.shooting || this.chargingPower) return;
        clearInterval(this.powerTimer);
        Object.assign(this, { score: 0, attempts: 0, made: 0, streak: 0,
          scored: false, missed: false, netJiggling: false,
          powerLevel: 0 });
        this.resetBall();
      },
    };
  }
</script>

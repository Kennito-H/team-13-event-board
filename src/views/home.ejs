<%
  const currentUser = session.authenticatedUser;
  const displayName = currentUser?.displayName ?? "there";
  const role = currentUser?.role ?? "guest";
%>

<section class="mb-5 p-6 md:p-8 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-sky-50 shadow-lg">
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">
    <div class="max-w-2xl">
      <p class="text-sm uppercase tracking-[0.2em] text-sky-700 font-semibold mb-2">Event Board</p>
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Welcome back, <%= displayName %></h1>
      <p class="text-slate-600 leading-7">
        Find upcoming events, manage your plans, and stay on top of it all from one place.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a
        href="/events"
        class="px-4 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium no-underline hover:bg-blue-700"
      >
        Browse Events
      </a>
      <a
        href="/events/search"
        class="px-4 py-2.5 rounded-lg bg-white text-slate-700 border border-slate-200 text-sm font-medium no-underline hover:bg-slate-50"
      >
        Search
      </a>
    </div>
  </div>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="grid gap-4 md:grid-cols-3 mb-5">
  <a
    href="/events"
    class="block p-5 border border-slate-200 rounded-2xl bg-white shadow-lg no-underline hover:-translate-y-0.5 hover:shadow-xl transition"
  >
    <p class="text-sm font-semibold text-blue-700 mb-2">Discover</p>
    <h2 class="text-xl font-semibold text-slate-900 mb-2">Upcoming Events</h2>
    <p class="text-sm text-slate-500 leading-6">Browse published events and filter by category or timeframe.</p>
  </a>

  <a
    href="/events/search"
    class="block p-5 border border-slate-200 rounded-2xl bg-white shadow-lg no-underline hover:-translate-y-0.5 hover:shadow-xl transition"
  >
    <p class="text-sm font-semibold text-emerald-700 mb-2">Find</p>
    <h2 class="text-xl font-semibold text-slate-900 mb-2">Event Search</h2>
    <p class="text-sm text-slate-500 leading-6">Look up events by title, description, or location.</p>
  </a>

  <a
    href="/events/archive"
    class="block p-5 border border-slate-200 rounded-2xl bg-white shadow-lg no-underline hover:-translate-y-0.5 hover:shadow-xl transition"
  >
    <p class="text-sm font-semibold text-amber-700 mb-2">Review</p>
    <h2 class="text-xl font-semibold text-slate-900 mb-2">Past Events</h2>
    <p class="text-sm text-slate-500 leading-6">Visit the archive to see events that have already occurred.</p>
  </a>
</section>

<section class="grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
  <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <div class="flex items-start justify-between gap-3 flex-wrap mb-4">
      <div>
        <p class="text-sm uppercase tracking-[0.18em] text-slate-500 font-semibold mb-2">Event Workshop</p>
        <h2 class="text-2xl font-semibold text-slate-900">Quick Actions</h2>
      </div>
      <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm font-semibold capitalize">
        <%= role %>
      </span>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <% if (role === "user") { %>
        <a href="/my-rsvps" class="px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 font-medium no-underline hover:bg-blue-50 hover:border-blue-200">
          My RSVPs
        </a>
      <% } %>

      <a href="/dashboard" class="px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 font-medium no-underline hover:bg-blue-50 hover:border-blue-200">
        Dashboard
      </a>

      <a href="/events/new" class="px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 font-medium no-underline hover:bg-blue-50 hover:border-blue-200">
        Create Event
      </a>

      <% if (role === "admin") { %>
        <a href="/admin/users" class="px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 font-medium no-underline hover:bg-blue-50 hover:border-blue-200">
          Manage Users
        </a>
      <% } %>
    </div>
  </div>

  <aside class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <p class="text-sm uppercase tracking-[0.18em] text-slate-500 font-semibold mb-2">Signed In</p>
    <h2 class="text-xl font-semibold text-slate-900 mb-3"><%= displayName %></h2>
    <% if (currentUser) { %>
      <dl class="grid gap-3 text-sm">
        <div>
          <dt class="text-slate-400 font-medium">Email</dt>
          <dd class="text-slate-700 mt-0.5"><%= currentUser.email %></dd>
        </div>
        <div>
          <dt class="text-slate-400 font-medium">Role</dt>
          <dd class="text-slate-700 mt-0.5 capitalize"><%= currentUser.role %></dd>
        </div>
      </dl>
    <% } %>
  </aside>
</section>

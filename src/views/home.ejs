<script>
  function basketballGame() {
    return {
      ballX: 80, ballY: 300, ballRotation: 0,
      shooting: false, scored: false, missed: false, netJiggling: false,
      score: 0, attempts: 0, made: 0, streak: 0,

      lerp(a, b, t) { return a + (b - a) * t; },

      bezier(p0, ctrl, p1, t) {
        const mt = 1 - t;
        return mt * mt * p0 + 2 * mt * t * ctrl + t * t * p1;
      },

      easeInOut(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      },

      shoot() {
        if (this.shooting) return;
        this.shooting = true;
        this.scored = false;
        this.missed = false;
        this.attempts++;

        const willMiss = Math.random() < 0.25;
        const sx = 80, sy = 300, cx = 220, cy = 15;
        const ex = willMiss ? 424 : 461;
        const ey = willMiss ? 163 : 161;
        const duration = 850;
        const startTime = performance.now();

        const animate = (now) => {
          const raw = Math.min((now - startTime) / duration, 1);
          const t = this.easeInOut(raw);
          this.ballX = this.bezier(sx, cx, ex, t);
          this.ballY = this.bezier(sy, cy, ey, t);
          this.ballRotation = raw * 700;
          if (raw < 1) {
            requestAnimationFrame(animate);
          } else if (!willMiss) {
            this.onMake();
          } else {
            this.onMiss();
          }
        };
        requestAnimationFrame(animate);
      },

      onMake() {
        this.score += 2;
        this.made++;
        this.streak++;
        this.scored = true;
        this.netJiggling = true;
        setTimeout(() => { this.netJiggling = false; }, 560);
        setTimeout(() => { this.scored = false; this.resetBall(); }, 1100);
      },

      onMiss() {
        this.streak = 0;
        this.missed = true;
        const bx = this.ballX, by = this.ballY, br = this.ballRotation;
        const fallDuration = 640;
        const startTime = performance.now();
        const fall = (now) => {
          const t = Math.min((now - startTime) / fallDuration, 1);
          const et = t * t;
          this.ballX = bx + this.lerp(0, 58, t);
          this.ballY = by + this.lerp(0, 235, et);
          this.ballRotation = br + t * 215;
          if (t < 1) {
            requestAnimationFrame(fall);
          } else {
            setTimeout(() => { this.missed = false; this.resetBall(); }, 320);
          }
        };
        requestAnimationFrame(fall);
      },

      resetBall() {
        this.ballX = 80; this.ballY = 300; this.ballRotation = 0; this.shooting = false;
      },

      reset() {
        if (this.shooting) return;
        Object.assign(this, { score: 0, attempts: 0, made: 0, streak: 0,
          scored: false, missed: false, netJiggling: false });
        this.resetBall();
      },
    };
  }
</script>

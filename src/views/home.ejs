        <path d="M 57 300 Q 80 323 103 300" fill="none" stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M 80 277 Q 103 300 80 323"  fill="none" stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round"/>

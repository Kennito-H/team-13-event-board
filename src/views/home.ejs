             bg-orange-500 hover:bg-orange-600 active:scale-95 transition-all
             disabled:opacity-40 disabled:cursor-not-allowed disabled:active:scale-100"
    >
      🏀 Shoot the Ball
    </button>
    <button
      @click="reset()"
      :disabled="shooting"
      class="py-3.5 px-5 rounded-xl font-medium text-slate-700 bg-white border border-slate-200
             hover:bg-slate-50 active:scale-95 transition-all shadow
             disabled:opacity-40 disabled:cursor-not-allowed"
    >
      Reset
    </button>
  </div>

